# Keep personal data outside the repository. Either variable can be used.
JOB_HUNTER_DATA_DIR=/Users/your-name/Documents/JobHunter/data
# JOB_HUNTER_DB_PATH=/absolute/path/to/job-hunter.sqlite
# JOB_HUNTER_DOCUMENTS_DIR=/Users/your-name/Documents/JobHunter/documents

# Dashboard refresh interval in milliseconds (minimum: 3000)
NEXT_PUBLIC_REFRESH_MS=10000
