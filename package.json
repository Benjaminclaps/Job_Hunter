    "drizzle-orm": "^0.45.4",
    "fflate": "^0.8.3",
    "geist": "^1.7.2",
    "lucide-react": "^1.56.0",
    "next": "^16.4.0",
    "pdf-parse": "^2.4.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
